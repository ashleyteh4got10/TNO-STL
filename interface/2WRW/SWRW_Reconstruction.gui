guiTypes = {
	#Reconstruction
	containerWindowType = {
		name = "TNO_RUS_MOS_Reconstruction_GUI"
		size = { width = 525 height = 450 }
		position = { x = 29 y = 131 }
		size = { width = 496 height = 506 }	

		containerWindowType = {
			name = "inner"
			position = { x = 0 y = 0 }

			iconType = {
				name = "sidebar"
				position = { x = 8 y = 8 }
				spriteType = "GFX_SWRW_rc_icon_moscow"
			}

			iconType = {
				name = "seal"
				position = { x = 153 y = 25 }
			}

			instantTextboxType = {
				name = "desc"
				position = { x = 118 y = 10 }
				font = "aldrich_18_outline"
				text = "SWRW_RC_sidebar_tt"
				maxWidth = 370
				format = left
			}

			iconType = {
				name = "warning_box"
				position = { x = 360 y = 320 }
				spriteType = "GFX_mandates_warning_box"
			}

			instantTextboxType = {
				name = "warning_text"
				position = { x = 364 y = 324 }
				font = "aldrich_24_outline"
				text = "[GetMOSCOWReconstructionStabilityWarning]"
				maxWidth = 122
				maxHeight = 101
				format = center
				vertical_alignment = center
				pdx_tooltip = "SWRW_warning_text_tt"
			}
			
			containerWindowType = {
				name = "Chunk"
				position = { x = 65 y = 370 }


				iconType = {
					name = "status_progbar"
					spriteType = "GFX_Southern_Seas_status_progbar"
					position = { x = 2 y = 0 }
					pdx_tooltip = Moscow_status_progbar_tt
				}
				iconType = {
					name = "status_frame"
					spriteType = "GFX_Southern_Seas_status_frame"
					position = { x = 0 y = 0 }
					pdx_tooltip = Moscow_status_progbar_tt
				}
				iconType = {
					name = "Flag"
					spriteType = "GFX_ORL_Flag"
					position = { x = -50 y = 3 }
					pdx_tooltip = Moscow_status_progbar_tt
				}
				iconType = {
					name = "Flag_overlay"
					spriteType = "GFX_flag_overlay_stateview"
					position = { x = -50 y = 2 }
					alwaystransparent = yes
					scale = 1.05
				}
				iconType = {
					name = "Midpoint"
					spriteType = "GFX_mandates_midpoint"
					position = { x = 140 y = -4 }
					alwaystransparent = yes
					scale = 1.05
				}
			}

			containerWindowType = {
			name = "reconstruction_container"
			position = { x = 8 y = 440 }

			instantTextboxType = {
				name = "reconstruction_economic_progress_indicator"
				position = { x = 168 y = 0 }
				font = "aldrich_18_outline"
				text = RUS_MOS_Reconstruction_Economy_text
				maxWidth = 420
				maxHeight = 50
				format = left
			}
			
			iconType = {
				name = "econ_status_progbar"
				spriteType = "GFX_Southern_Seas_status_progbar"
				position = { x = 92 y = 20 }
			}
			iconType = {
				name = "status_frame"
				spriteType = "GFX_Southern_Seas_status_frame"
				position = { x = 90 y = 20 }
			}
		}
		}
	}

