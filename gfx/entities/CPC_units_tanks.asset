		event = { time = 0 node="barrel" particle = "light_tank_attack_barrel_smoke_particle"  keep_particle = yes sound = { soundeffect = medium_armour_fire } } 
	}
	state = { name = "support_attack"	animation = "attack" animation_blend_time = 0.3  
